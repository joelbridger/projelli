{
  "name": "@projelli/plugin-api",
  "version": "1.0.0",
  "description": "TypeScript types for the Projelli plugin API. Import these in your plugin source for full IntelliSense against the Projelli runtime.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rm -rf dist src/_app-types src/index.ts"
  },
  "keywords": [
    "projelli",
    "plugin",
    "api",
    "types"
  ],
  "author": "Projelli",
  "homepage": "https://projelli.com/docs/plugins",
  "repository": {
    "type": "git",
    "url": "https://github.com/projelli/projelli.git",
    "directory": "packages/plugin-api"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
