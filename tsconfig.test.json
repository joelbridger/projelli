{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests run in Node (Vitest) + jsdom, so relax a few bundler-mode
    // restrictions that don't apply to the test runner.
    "moduleResolution": "bundler",
    // noEmit stays on — we're type-checking only.
    "noEmit": true,
    // Tests use vi.fn() stubs + jest-dom matchers that aren't in the main
    // lib. Adding vitest/globals here keeps "describe/it/expect" typed
    // without requiring a separate @types/jest dependency.
    "types": ["vitest/globals"],
    // tests/ has its own setup imports (React Testing Library, jest-dom)
    // that don't exist in src/. Keep unused-locals off for test files so
    // helper imports that are only side-effected don't fail the check.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // Include both src (so @/ imports resolve) and the Vitest suite. The two
  // standalone campaign runners are Bun programs, not Vitest tests. In
  // particular, trustbreakers/run.ts imports the Bun backend and must stay in
  // the backend's own strict type/test project rather than pulling that whole
  // project into this browser/jsdom check with the wrong ambient types.
  "include": ["src", "tests"],
  "exclude": ["tests/crm/trustbreakers/run.ts", "tests/parity/run.ts"]
}
