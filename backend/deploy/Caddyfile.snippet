# Caddy snippet for the Keepance firm backend (api.keepance.com).
#
# DO NOT REPLACE the live /etc/caddy/Caddyfile with this. This is ONE host block
# to INSERT inside the existing `:8080 { ... }` site block, alongside the other
# @host handlers. See deploy/RUNBOOK.md for the exact placement + reload steps.
#
# It mirrors the existing licenses.keepance.com block (loopback reverse_proxy +
# hardening headers), pointed at the firm backend's chosen port 5194. It is
# additive: it does not touch the @licenses block (5181) or any other host.
#
# Recommended placement: immediately AFTER the existing @licenses handle { ... }
# block (around line 66 of the current Caddyfile), so the two API services sit
# together and read clearly.

    # api.keepance.com — Keepance firm backend (Bun systemd service; loopback-only)
    @firmapi host api.keepance.com
    handle @firmapi {
        # Loopback-only Bun service on 5194. Only Caddy should reach it.
        # WebSocket (the matter-sync relay at /matter/:id/sync) is reverse-proxied
        # transparently by Caddy — no extra directive needed.
        reverse_proxy 127.0.0.1:5194

        # Sensible defaults for an API service (same as the @licenses block).
        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "no-referrer"
        }
    }
