# Keepance firm backend — environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (gitignored).

# --- HTTP ---
# Bind to loopback in production; a reverse proxy (Caddy) terminates TLS and
# is the only thing that talks to this service. 0.0.0.0 only for local dev.
HOST=127.0.0.1
PORT=5190

# --- Secrets (REQUIRED in production; auto-generated ephemeral in dev) ---
# Symmetric secret used to sign short-lived access JWTs (HS256) and to HMAC
# refresh tokens at rest. Generate with: openssl rand -hex 48
# If unset, the server generates a RANDOM per-boot secret and logs a warning —
# fine for local testing (tokens won't survive a restart), unacceptable in prod.
AUTH_SECRET=

# Ed25519 PEM keys used to sign + verify *seat tokens* (asymmetric, so the
# desktop client embeds only the PUBLIC key and can verify a seat offline but
# can never mint one). Generate a pair with: bun run keygen
# Provide EITHER inline PEM (handy for env-only deploys / containers)...
SEAT_PRIVATE_KEY_PEM=
SEAT_PUBLIC_KEY_PEM=
# ...OR a path to PEM files on disk (takes precedence over inline if set).
SEAT_PRIVATE_KEY_PATH=
SEAT_PUBLIC_KEY_PATH=

# --- Storage ---
# SQLite database path. ":memory:" for an ephemeral DB (tests use their own).
DB_PATH=./data/keepance-firm.sqlite

# --- Token lifetimes ---
# Access JWT TTL (seconds). Short-lived; the client refreshes it. Default 1h.
ACCESS_TOKEN_TTL_SECONDS=3600
# Refresh token TTL (seconds). Long-lived; rotated on use. Default 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000
# Seat token TTL (seconds). The offline grace window: the client trusts a
# signed seat token by signature+expiry between online heartbeats. Default 30d,
# matching the legacy license-validator grace period.
SEAT_TOKEN_TTL_SECONDS=2592000

# --- Heartbeat / reclaim ---
# A seat with no heartbeat for this many seconds is considered "inactive" and
# is surfaced to admins as reclaimable. Default 14 days. (Reclaim is a manual
# admin action, never automatic — never silently free a seat someone is using.)
SEAT_INACTIVE_AFTER_SECONDS=1209600

# --- Rate limiting (auth endpoints) ---
# Max auth attempts (signup/login/refresh) per IP per window before 429.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Bootstrap (optional, dev convenience) ---
# If set, on first boot the server creates this org + an admin user so you can
# exercise the API immediately. Ignored if the org already exists.
# BOOTSTRAP_ORG_NAME="Acme Law LLP"
# BOOTSTRAP_ADMIN_EMAIL="admin@acmelaw.example"
# BOOTSTRAP_ADMIN_PASSWORD="change-me-at-least-12-chars"
# BOOTSTRAP_SEAT_LIMIT=5
# BOOTSTRAP_PLAN=practice
