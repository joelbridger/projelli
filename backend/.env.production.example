# Keepance firm backend — PRODUCTION environment TEMPLATE.
#
# This is the committed, SECRET-FREE template. The real file is `.env.production`
# (gitignored) — generate it by filling in the placeholders below, or let the
# deploy step generate the secrets for you (see deploy/RUNBOOK.md).
#
# In production this content is installed to /etc/keepance-firm-backend.env
# (owner root:jameson, chmod 640) and referenced by the systemd unit's
# EnvironmentFile= directive (deploy/keepance-backend.service) — exactly the
# pattern the existing license-validator service uses (/etc/license-validator.env).
#
# NEVER put real secret values in THIS file. Real secrets live only in the
# gitignored .env.production / the /etc env file.

# --- HTTP (loopback only; Caddy terminates TLS and is the only caller) ---
HOST=127.0.0.1
# Chosen port for this host: 5194.
# 5190 (README default), 5191, and 5193 were already occupied by other Bun
# services on this server, so the firm backend uses 5194 (verified free
# 2026-06-09). If you redeploy elsewhere, pick any free loopback port and keep
# this, the systemd unit, the Caddy snippet, and the cloudflared snippet aligned.
PORT=5194

# --- Secrets (REQUIRED in production; must be STABLE across restarts) ---
# The server auto-generates ephemeral secrets in dev and WARNS; ephemeral
# secrets are unacceptable in prod because issued tokens won't survive a restart.

# Signs short-lived access JWTs (HS256) + HMACs refresh tokens at rest.
# Generate: openssl rand -hex 48   (MUST be >=32 chars or the server throws.)
AUTH_SECRET=

# Global operations credential for POST /admin/org. Generate independently:
#   openssl rand -hex 48
# Sent as Authorization: Bearer; empty locks the route closed.
ADMIN_PROVISION_SECRET=

# Ed25519 keypair that signs/verifies SEAT TOKENS. The desktop client embeds
# ONLY the PUBLIC key (also served at GET /.well-known/seat-pubkey) and verifies
# seats offline — it can never mint one. Generate BOTH with: bun run keygen
# (prints the escaped single-line forms ready to paste here).
SEAT_PRIVATE_KEY_PEM=
SEAT_PUBLIC_KEY_PEM=
# ...OR point at PEM files on disk instead (these take precedence if set):
# SEAT_PRIVATE_KEY_PATH=
# SEAT_PUBLIC_KEY_PATH=

# --- Storage (persistent SQLite; the WAL/SHM siblings live alongside) ---
# Keep this OUTSIDE the git working tree, on a path the systemd unit grants
# write access to via ReadWritePaths=.
DB_PATH=/home/jameson/services/keepance-firm-backend/data/keepance-firm.sqlite

# --- Token lifetimes (defaults shown; uncomment to override) ---
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# SEAT_TOKEN_TTL_SECONDS=2592000
# SEAT_INACTIVE_AFTER_SECONDS=1209600

# --- Auth rate limiting (in-memory; single instance) ---
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Assured zero-retention inference proxy ---
# Master secret under which per-org MANAGED provider keys are encrypted at rest
# (AES-256-GCM via HKDF). Set a DEDICATED value (not derived from AUTH_SECRET) so
# it can be rotated independently. Generate: openssl rand -hex 48
# Only needed if any firm uses the Assured tier; safe to set proactively.
MANAGED_KEY_SECRET=
# ASSURED_RATE_LIMIT_MAX=120
# ASSURED_RATE_LIMIT_WINDOW_SECONDS=60
# ASSURED_UPSTREAM_TIMEOUT_MS=120000
# ASSURED_MAX_REQUEST_BYTES=8388608
