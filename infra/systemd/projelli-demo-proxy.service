[Unit]
Description=Projelli demo proxy (rate-limited Anthropic forwarder for projelli.com/try)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jameson
Group=jameson
WorkingDirectory=/home/jameson/services/projelli-demo-proxy
EnvironmentFile=/etc/projelli-demo-proxy.env
ExecStart=/home/jameson/.bun/bin/bun run /home/jameson/services/projelli-demo-proxy/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/projelli-demo-proxy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
