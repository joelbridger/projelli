{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Projelli",
  "version": "2.0.0",
  "identifier": "com.projelli.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Projelli",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://projelli.com https://licenses.projelli.com http://127.0.0.1:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first workspace for solo founders",
    "longDescription": "Projelli is a local-first, artifact-driven workspace application for solo founders building businesses with AI assistance. Unlike chat-based AI tools, Projelli produces and manages persistent business documents while keeping the human founder in control of all decisions.",
    "publisher": "Projelli",
    "copyright": "Copyright 2026 Projelli",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.acs.microsoft.com",
      "signCommand": null,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh",
        "template": "./windows/installer-silent.nsi"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "resources": [
      "resources/**/*",
      "binaries/**/*"
    ],
    "externalBin": [
      "binaries/piper"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDMjMyQzcyQThCMDA4QjkKUldTNUNMQ29jaXdqTEQ2V0tEcUxIMS9IZy9BaFUyeXNHQmk5NlAyZ2hEMlZ5QUxNTmNiSnNBNjgK",
      "endpoints": [
        "https://github.com/projelli/projelli/releases/latest/download/latest.json"
      ]
    }
  }
}