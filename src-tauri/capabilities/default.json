{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lantern default permissions for workspace operations. Least privilege: every grant below has at least one real caller (see prep/PLUGIN-PERMISSION-SURFACE-SWEEP-c34.md). The filesystem scope starts EMPTY and is populated at runtime, from Rust, with directories the user actually picked in a native dialog (see src-tauri/src/commands/workspace_scope.rs and tauri-plugin-dialog's own allow_file/allow_directory).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",

    "dialog:allow-open",
    "dialog:allow-save",

    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",

    "shell:allow-open",

    "updater:allow-check",
    "updater:allow-download-and-install",

    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/**" },
        { "url": "https://api.openai.com/**" },
        { "url": "https://generativelanguage.googleapis.com/**" },
        { "url": "https://forms.lanternplatform.app/api/forms/**" },
        { "url": "https://licenses.lanternplatform.app/**" },
        { "url": "https://api.lanternplatform.app/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [],
      "deny": [
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPLOCALDATA/EBWebView/**" },
        { "path": "C:/Windows/**" },
        { "path": "C:/Program Files/**" },
        { "path": "C:/Program Files (x86)/**" },
        { "path": "/etc/**" },
        { "path": "/usr/bin/**" },
        { "path": "/bin/**" },
        { "path": "/sbin/**" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    }
  ]
}
