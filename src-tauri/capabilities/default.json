{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Projelli default permissions for workspace operations",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-stat",
    "fs:allow-lstat",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/**" },
        { "url": "https://api.openai.com/**" },
        { "url": "https://generativelanguage.googleapis.com/**" },
        { "url": "https://projelli.com/api/forms/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**/*" }
      ],
      "deny": [
        { "path": "C:/Windows/**" },
        { "path": "C:/Program Files/**" },
        { "path": "C:/Program Files (x86)/**" },
        { "path": "/etc/**" },
        { "path": "/usr/bin/**" },
        { "path": "/bin/**" },
        { "path": "/sbin/**" },
        { "path": "$HOME/Library/Keychains/**" }
      ]
    }
  ]
}
